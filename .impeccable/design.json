      "html": "<div class=\"ds-ground\"><article class=\"ds-kartu\"><div class=\"ds-kartu-kepala\"><span>Kartu Bukti Memilih</span></div><div class=\"ds-kartu-isi\"><span class=\"ds-lbl\">Pemilihan</span><b>Pemilihan Ketua OSIM 2026/2027</b></div><div class=\"ds-perf\"></div><div class=\"ds-kartu-isi\"><span class=\"ds-lbl\">Kode bukti</span><b class=\"ds-kode\">OSIM-UJI1-COBA</b></div></article></div>",
      "css": ".ds-ground{background:#f2f8f3;padding:24px}.ds-kartu{overflow:hidden;border-radius:14px;background:#fff;box-shadow:0 18px 40px -18px rgb(4 41 26/.5),0 0 0 1px #d3e4d7;color:#14261b;font-family:'Figtree Variable',sans-serif}.ds-kartu-kepala{background:#e3f1e6;padding:10px 20px;color:#0a5a2d;font:700 11px 'Archivo Variable',sans-serif;font-variation-settings:'wdth' 75;letter-spacing:.14em;text-transform:uppercase}.ds-kartu-isi{padding:20px}.ds-lbl{display:block;font:700 11px 'Archivo Variable',sans-serif;font-variation-settings:'wdth' 75;letter-spacing:.14em;text-transform:uppercase;color:#3d5c48}.ds-kode{font:900 1.5rem 'Archivo Variable',sans-serif;color:#0c6633;letter-spacing:.05em}.ds-perf{position:relative;border-top:2px dashed #d3e4d7;margin:0 18px}.ds-perf::before,.ds-perf::after{content:'';position:absolute;top:-12px;width:22px;height:22px;border-radius:9999px;background:#f2f8f3}.ds-perf::before{left:-30px}.ds-perf::after{right:-30px}"
